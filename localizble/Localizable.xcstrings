    "subscription.paywall.termAutoRenew" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Your subscription automatically renews unless auto-renew is turned off at least 24 hours before the end of the current period."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Gói đăng ký của bạn sẽ tự động gia hạn trừ khi tính năng tự động gia hạn được tắt ít nhất 24 giờ trước khi kết thúc chu kỳ hiện tại."
          }
        }
      }
    },
