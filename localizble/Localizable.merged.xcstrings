    "onboarding.bmiAdvice.severeRiskHigh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: This goal poses severe health risks. We recommend setting a slightly lower goal for your health."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo: Mục tiêu này gây ra rủi ro sức khỏe nghiêm trọng. Chúng tôi khuyên bạn nên đặt mục tiêu thấp hơn một chút vì sức khỏe."
