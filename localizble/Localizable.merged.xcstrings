    "nutrition.bmi.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body Mass Index is a standard measurement of body fat based on height and weight, calculated according to WHO guidelines."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ số khối cơ thể (BMI) là phép đo chuẩn về mỡ cơ thể dựa trên chiều cao và cân nặng, được tính theo hướng dẫn của WHO."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Body-Mass-Index ist ein Standardmaß für Körperfett basierend auf Größe und Gewicht, berechnet nach WHO-Richtlinien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Índice de Masa Corporal es una medida estándar de la grasa corporal basada en la altura y el peso, calculada según las pautas de la OMS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indice de masse corporelle est une mesure standard de la graisse corporelle basée sur la taille et le poids, calculée selon les directives de l'OMS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボディマス指数（BMI）は、WHOのガイドラインに基づいて身長と体重から算出される体脂肪の標準指標です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체질량지수(BMI)는 WHO 기준에 따라 키와 몸무게를 바탕으로 체지방을 측정하는 표준 지표입니다."
          }
        }
      }
    },
