    "onboarding.bmiAdvice.highRisk" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This target keeps you in a high-risk zone. We recommend setting a slightly lower goal for your health."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục tiêu này khiến bạn nằm trong vùng rủi ro cao. Chúng tôi khuyên bạn nên đặt mục tiêu thấp hơn một chút vì sức khỏe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Ziel bringt dich in einen Hochrisikobereich. Wir empfehlen ein etwas niedrigeres Ziel für deine Gesundheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este objetivo te sitúa en una zona de alto riesgo. Recomendamos fijar un objetivo ligeramente más moderado por tu salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet objectif vous place dans une zone à risque élevé. Nous vous recommandons de fixer un objectif légèrement plus modéré pour votre santé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この目標は高リスクゾーンに該当します。健康のために少し控えめな目標設定をおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목표는 위험도가 높은 범위에 속합니다. 건강을 위해 조금 더 낮춘 목표를 권장합니다."
          }
        }
      }
    },
    "onboarding.bmiAdvice.low" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bit too low. Aiming for a slightly higher weight will help boost your daily energy."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức này hơi thấp. Hướng tới cân nặng cao hơn một chút sẽ giúp tăng cường năng lượng hàng ngày của bạn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas zu niedrig. Ein leicht höheres Gewicht hilft dir, deine tägliche Energie zu steigern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco demasiado bajo. Apuntar a un peso ligeramente mayor te ayudará a aumentar tu energía diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu trop bas. Viser un poids légèrement plus élevé vous aidera à stimuler votre énergie quotidienne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し低すぎます。もう少し高い体重を目指すと日常のエネルギーが高まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조금 낮습니다. 약간 더 높은 체중을 목표로 설정하면 일상 에너지를 높이는 데 도움이 됩니다."
          }
        }
      }
    },
