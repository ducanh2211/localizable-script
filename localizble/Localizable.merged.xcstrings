    "mealReview.notReadyDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your meal review isn't ready yet. We're analyzing the nutrition and balance of your meal to provide accurate feedback."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh giá bữa ăn của bạn chưa sẵn sàng. Chúng tôi đang phân tích dinh dưỡng và sự cân bằng của bữa ăn để đưa ra phản hồi chính xác."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mahlzeitenbewertung ist noch nicht bereit. Wir analysieren Nährstoffe und ausgewogene Ernährung, um genaue Rückmeldungen zu geben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La revisión de tus comidas aún no está lista. Estamos analizando la nutrición y el equilibrio de tus comidas para ofrecerte información precisa."
